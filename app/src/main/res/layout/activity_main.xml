<!-- res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <Button android:id="@+id/btAesCbc" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Run AES-CBC (BC)"/>

    <Button android:id="@+id/btAesGcm" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Run AES-GCM" android:layout_marginTop="8dp"/>

    <Button android:id="@+id/btChaCha20" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Run ChaCha20" android:layout_marginTop="8dp"/>

    <Button android:id="@+id/btRsaHybrid" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Run RSA Hybrid" android:layout_marginTop="8dp"/>

    <Button android:id="@+id/btElGamal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Run ElGamal Hybrid" android:layout_marginTop="8dp"/>
    <Button
        android:id="@+id/btAscon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run Ascon-128" />
    <Button
        android:id="@+id/btElephant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run Elephant" />
    <Button
        android:id="@+id/btGiftCofb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run GiftCofb" />
    <Button
        android:id="@+id/btGrain128"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run Grain-128" />
    <Button
        android:id="@+id/btXoodyak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run Xoodyak-128" />

    <Button
        android:id="@+id/btRunAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF5722"
        android:text="RUN ALL BENCHMARKS"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btShareAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Share All Results (ZIP)"
        android:visibility="gone"
        android:backgroundTint="#4CAF50" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:text="Ready"/>
    </ScrollView>
</LinearLayout>
